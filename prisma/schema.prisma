generator client {
  provider        = "prisma-client-js"
  // Los include se cargan con JOIN en una sola consulta (por defecto con esta opción) en vez de
  // una consulta por relación: la ficha del lead pasa de 11 idas y vueltas a la base a 1.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexión directa (sin pooler) para migraciones. En local puede ser igual a DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EXECUTIVE
}

enum Channel {
  SIMULATOR
  WHATSAPP
  INSTAGRAM
  FACEBOOK
}

enum LeadStatus {
  OPEN
  WON
  LOST
}

enum MessageAuthor {
  CONTACT
  AI
  USER
}

enum Actor {
  AI
  USER
  SYSTEM
}

enum RuleTrigger {
  STAGE_ENTERED
  TAG_ADDED
}

/// Tipo de un campo del cliente: define cómo se valida y se muestra el valor.
enum FieldType {
  TEXT
  NUMBER
  OPTIONS
  RUT
}

enum AssignStrategy {
  ROUND_ROBIN
  LEAST_LOADED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EXECUTIVE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  leads        Lead[]           @relation("Assignee")
  messages     Message[]
  events       LeadEvent[]
  rules        AssignmentRule[] @relation("RuleExecutives")
  tasks        Task[]           @relation("TaskAssignee")
  createdTasks Task[]           @relation("TaskCreator")

  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  comments          SocialComment[]
}

/// Etapa del funnel de ventas. `requiresHuman` marca la etapa de atención humana:
/// al entrar, la IA se pausa y se asigna un ejecutivo.
model Stage {
  id            String  @id @default(cuid())
  /// Embudo al que pertenece. "default" es el embudo que crea la migración (ver DEFAULT_FUNNEL_ID).
  funnelId      String  @default("default")
  name          String
  position      Int
  requiresHuman Boolean @default(false)
  color         String  @default("#64748b")
  /// Etapas que atiende la IA: cuándo debe sacar al lead de esta etapa y hacia cuál. Texto libre
  /// que la asistente recibe en <crm_state>; sin destino nombrado, avanza a la siguiente.
  exitCriteria  String?

  funnel   Funnel           @relation(fields: [funnelId], references: [id])
  leads    Lead[]
  rules    AssignmentRule[]
  webhooks Webhook[]

  @@unique([funnelId, name])
  @@index([funnelId, position])
}

/// Embudo de ventas: una línea de negocio con sus etapas y, si se configura, su propia asistente
/// (nombre e instrucciones). Los leads nuevos de un canal entran al embudo que tiene ese canal.
model Funnel {
  id            String    @id @default(cuid())
  name          String    @unique
  position      Int
  /// Canales cuyos leads nuevos entran a este embudo. Un canal sin embudo va al primero.
  channels      Channel[]
  /// Nombre de la asistente en este embudo; vacío usa el de Configuración → Asistente.
  assistantName String?
  /// Instrucciones propias de este embudo, que se suman a las generales.
  instructions  String?
  createdAt     DateTime  @default(now())

  stages          Stage[]
  whatsAppNumbers WhatsAppNumber[]
}

/// Número de WhatsApp adicional de la misma app de Meta (usa WHATSAPP_TOKEN). Los leads nuevos
/// que le escriben entran a su embudo; sin embudo, al del canal WhatsApp.
model WhatsAppNumber {
  id            String   @id @default(cuid())
  phoneNumberId String   @unique
  label         String
  displayPhone  String?
  funnelId      String?
  createdAt     DateTime @default(now())

  funnel Funnel? @relation(fields: [funnelId], references: [id], onDelete: SetNull)
}

/// Etiqueta de contacto agrupada por categoría (ej. "Producto" / "Interés").
model Tag {
  id       String @id @default(cuid())
  category String
  name     String
  color    String @default("#0ea5e9")

  contacts ContactTag[]
  rules    AssignmentRule[]

  @@unique([category, name])
}

model Contact {
  id         String   @id @default(cuid())
  name       String
  phone      String?
  email      String?
  channel    Channel
  externalId String?
  createdAt  DateTime @default(now())
  /// Contacto bloqueado (spam, mensajes personales, postulantes): sus mensajes nuevos se
  /// descartan y ni la IA ni el equipo le escriben (ver src/lib/domain/contacts.ts).
  blockedAt     DateTime?
  blockedReason String?
  /// Número de WhatsApp (phone_number_id) al que escribió por última vez; las respuestas salen
  /// por ese número. Vacío usa WHATSAPP_PHONE_NUMBER_ID.
  waPhoneNumberId String?

  tags   ContactTag[]
  leads  Lead[]
  fields ContactFieldValue[]

  @@unique([channel, externalId])
}

model ContactTag {
  contactId String
  tagId     String
  addedBy   Actor
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

/// Campo del cliente que define el admin (ej. RUT, presupuesto, región de interés). La IA lo
/// completa con set_contact_field a medida que el cliente entrega el dato.
model CustomField {
  id          String    @id @default(cuid())
  name        String    @unique
  type        FieldType @default(TEXT)
  /// Valores permitidos cuando el tipo es OPTIONS.
  options     String[]
  /// Indicación para la IA: qué guardar y cuándo preguntarlo.
  description String    @default("")
  position    Int

  values ContactFieldValue[]
}

/// Valor de un campo del cliente, ya validado y normalizado según el tipo del campo.
model ContactFieldValue {
  contactId String
  fieldId   String
  value     String
  updatedBy Actor
  updatedAt DateTime @updatedAt

  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  field   CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([contactId, fieldId])
}

/// Un lead (ticket) es una oportunidad de venta de un contacto que avanza por el funnel.
model Lead {
  id             String     @id @default(cuid())
  contactId      String
  stageId        String
  status         LeadStatus @default(OPEN)
  lostReason     String?
  amount         Int?
  assigneeId     String?
  aiEnabled      Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  closedAt       DateTime?
  /// Próximo seguimiento de la IA si el cliente no responde (ver src/lib/domain/follow-ups.ts).
  followUpAt     DateTime?
  /// Seguimientos enviados desde el último mensaje del cliente.
  followUpCount  Int        @default(0)
  /// Motivo cuando la IA agendó el recontacto para una fecha; vacío si es automático.
  followUpReason String?

  /// Resumen de una línea de dónde quedó la conversación, hecho por la IA (ver src/lib/ai/insights.ts).
  aiSummary      String?
  /// Puntaje 0-100 de qué tan probable es que compre, con su motivo; lo calcula la IA.
  score          Int?
  scoreReason    String?
  /// Mientras la IA responde por un canal real, evita que dos servidores le contesten a la vez
  /// (ver src/lib/domain/channels.ts).
  agentBusyUntil DateTime?

  /// Último mensaje (Message.createdAt) considerado en el resumen y el puntaje.
  insightsAt DateTime?

  /// Variante de la asistente que le tocó en una prueba A/B (ver src/lib/domain/ab-tests.ts).
  variantId String?

  contact       Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stage         Stage             @relation(fields: [stageId], references: [id])
  assignee      User?             @relation("Assignee", fields: [assigneeId], references: [id])
  messages      Message[]
  events        LeadEvent[]
  transcript    AgentTranscript?
  agentRuns     AgentRun[]
  tasks         Task[]
  notifications Notification[]
  source        LeadSource?
  conversions   ConversionEvent[]
  webhookCalls  WebhookDelivery[]
  variant       AssistantVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([stageId])
  @@index([assigneeId])
  @@index([followUpAt])
  @@index([variantId])
}

/// Variante de la asistente en una prueba A/B por canal. Cada lead nuevo del canal recibe una
/// variante activa al azar según su peso y la mantiene toda la conversación.
model AssistantVariant {
  id            String   @id @default(cuid())
  name          String
  channel       Channel
  /// Nombre de la asistente en esta variante; vacío usa el del embudo o el general.
  assistantName String?
  /// Instrucciones que se suman a las del embudo y las generales.
  instructions  String   @default("")
  /// Proporción relativa de leads nuevos que reciben esta variante.
  weight        Int      @default(50)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  leads Lead[]
}

model Message {
  id             String        @id @default(cuid())
  leadId         String
  author         MessageAuthor
  userId         String?
  /// Texto del mensaje. Vacío en una nota de voz sin texto.
  body           String
  /// Archivo adjunto (por ahora, notas de voz del cliente): URL en Vercel Blob y tipo MIME.
  mediaUrl       String?
  mediaType      String?
  /// Nombre del archivo enviado como documento (ej. "masterplan.pdf").
  mediaName      String?
  /// Transcripción de la nota de voz; null si no se pudo transcribir.
  transcript     String?
  createdAt      DateTime      @default(now())
  /// Id del mensaje en el canal (ej. wamid de WhatsApp). Evita guardar dos veces el mismo
  /// mensaje entrante y permite seguir el estado de entrega de uno saliente.
  externalId     String?       @unique
  /// Entrega de un mensaje saliente por el canal: SENDING, SENT, DELIVERED, READ o FAILED.
  /// Null en el simulador y en los mensajes del cliente.
  deliveryStatus String?
  /// Motivo cuando el canal no pudo entregar el mensaje.
  deliveryError  String?

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id])
  agentRun AgentRun?

  @@index([leadId, createdAt])
}

/// Monitor de actividad: cómo la IA construyó una respuesta (contexto, pasos del modelo y
/// herramientas usadas). Uno por turno; se guarda junto al mensaje que envió.
model AgentRun {
  id         String   @id @default(cuid())
  leadId     String
  messageId  String   @unique
  provider   String
  /// Modelo configurado; el que respondió de verdad va en cada paso de `steps`.
  model      String
  effort     String
  /// Etapa del lead al empezar el turno.
  stageName  String
  system     String
  /// Lo que recibió la IA como turno del usuario (<crm_state> y mensajes pendientes).
  context    String
  /// Línea de tiempo del turno: llamadas al modelo, herramientas y errores (ver src/lib/ai/trace.ts).
  steps      Json     @default("[]")
  /// "reply" (respuesta normal) o "fallback" (respuesta de respaldo).
  outcome    String
  startedAt  DateTime
  durationMs Int

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

/// Historial de la conversación con Claude tal como se envía a la API (incluye
/// bloques de herramientas y de razonamiento). Solo se agrega al final, nunca se edita.
model AgentTranscript {
  leadId      String   @id
  /// Formato de API del historial ("anthropic" u "openai"); depende del proveedor configurado.
  format      String   @default("anthropic")
  messages    Json     @default("[]")
  /// Último mensaje (Message.createdAt) ya incluido en el historial de la IA.
  syncedUntil DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadEvent {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  actor     Actor
  userId    String?
  reason    String?
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId, createdAt])
}

/// Tarea con plazo sobre un lead, para un ejecutivo. La crea un ejecutivo a mano o la IA
/// (herramienta create_task). Si el lead cambia de ejecutivo, sus tareas pendientes lo siguen.
model Task {
  id          String    @id @default(cuid())
  leadId      String
  title       String
  notes       String?
  dueAt       DateTime
  assigneeId  String?
  createdBy   Actor
  createdById String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  /// Cuándo se avisó que la tarea estaba por vencer (ver sendTaskReminders); null = aún no.
  remindedAt  DateTime?

  lead     Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  User? @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([assigneeId, completedAt, dueAt])
  @@index([leadId])
}

/// Regla de asignación automática: cuando ocurre el disparador, se asigna un ejecutivo
/// de la lista (o de todos los ejecutivos activos si la lista está vacía).
model AssignmentRule {
  id                 String         @id @default(cuid())
  name               String
  priority           Int            @default(0)
  active             Boolean        @default(true)
  trigger            RuleTrigger
  stageId            String?
  tagId              String?
  strategy           AssignStrategy @default(ROUND_ROBIN)
  /// Si es true, reasigna aunque el lead ya tenga ejecutivo.
  reassign           Boolean        @default(false)
  lastAssignedUserId String?
  createdAt          DateTime       @default(now())

  stage      Stage? @relation(fields: [stageId], references: [id], onDelete: Cascade)
  tag        Tag?   @relation(fields: [tagId], references: [id], onDelete: Cascade)
  executives User[] @relation("RuleExecutives")
}

/// Archivo que la IA puede enviar a los leads (masterplan, ficha técnica, fotos), cargado en
/// Configuración → Archivos. `description` le dice a la IA cuándo enviarlo.
model MediaFile {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  url         String
  mimeType    String
  fileName    String
  size        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KnowledgeDoc {
  id        String   @id @default(cuid())
  title     String
  content   String
  updatedAt DateTime @updatedAt
}

model InventoryItem {
  id         String   @id @default(cuid())
  rowNumber  Int
  data       Json
  searchText String
  syncedAt   DateTime @default(now())
}

model Setting {
  key   String @id
  value Json
}

/// Aviso al ejecutivo sobre un lead (ver src/lib/domain/notifications.ts). Hay a lo más uno
/// sin leer por usuario y lead: los avisos nuevos lo actualizan con el último motivo.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  leadId    String
  /// HUMAN_STAGE, ASSIGNED, CONTACT_MESSAGE o TASK_DUE.
  type      String
  title     String
  body      String
  readAt    DateTime?
  /// Cuándo se envió (o descartó) el push al navegador; null = pendiente.
  pushedAt  DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([pushedAt])
}

/// Suscripción Web Push de un navegador (uno por dispositivo del usuario).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Comentario en una publicación de Instagram o de la página de Facebook. El equipo lo responde
/// en público o por mensaje privado (ver src/lib/domain/comments.ts).
model SocialComment {
  id         String   @id @default(cuid())
  channel    Channel
  /// Id del comentario en Meta.
  externalId String   @unique
  postId     String?
  /// Comentario al que responde, si es una respuesta dentro de un hilo.
  parentId   String?
  authorId   String?
  authorName String
  text       String
  createdAt  DateTime @default(now())

  /// Respuesta pública del equipo, en el mismo hilo del comentario.
  reply        String?
  repliedAt    DateTime?
  /// Mensaje privado al autor (Meta permite uno por comentario, dentro de 7 días).
  privateReply String?
  privateAt    DateTime?
  repliedById  String?
  hidden       Boolean   @default(false)
  /// Lo marcó como resuelto alguien del equipo (respondido o descartado).
  doneAt       DateTime?

  /// Regla que lo atendió sola (ver CommentRule); null si lo atendió el equipo.
  ruleId       String?
  /// Lo borró una regla en Meta; se guarda acá para el historial.
  removedAt    DateTime?

  repliedBy User?        @relation(fields: [repliedById], references: [id])
  rule      CommentRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([doneAt, createdAt])
  @@index([ruleId])
}

/// Respuesta automática a comentarios nuevos, por publicación y palabras clave. Se crea
/// inactiva: solo actúa cuando alguien la activa (ver src/lib/domain/comment-rules.ts).
model CommentRule {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(false)
  /// INSTAGRAM o FACEBOOK; null = ambas.
  channel   Channel?
  /// Publicación a la que aplica; null = todas.
  postId    String?
  /// Texto o enlace de la publicación, para mostrarla en la configuración.
  postLabel String?
  /// Palabras o frases a buscar en el comentario; vacío = cualquier comentario.
  keywords  String[]
  /// Respuesta pública en el hilo. {nombre} se reemplaza por el autor.
  publicReply  String?
  /// Mensaje privado al autor; si contesta, entra al funnel como lead.
  privateReply String?
  hide      Boolean  @default(false)
  /// Borra el comentario en Meta (no se puede deshacer).
  remove    Boolean  @default(false)
  createdAt DateTime @default(now())

  comments SocialComment[]
}

/// Pedido de una persona (vía Meta) para borrar sus datos. El código se le muestra para que
/// pueda consultar el estado en /eliminacion-de-datos.
model DataDeletionRequest {
  id             String   @id @default(cuid())
  code           String   @unique
  /// Id de la persona en Meta (app-scoped) que pidió el borrado.
  externalUserId String
  /// Contactos y comentarios borrados.
  contacts       Int      @default(0)
  comments       Int      @default(0)
  createdAt      DateTime @default(now())
}

/// Origen de un lead (ver src/lib/domain/attribution.ts): el anuncio de Meta por el que escribió
/// (clic a WhatsApp, Instagram o Messenger) o los UTM del enlace de Bella que usó una landing.
/// Se guarda con el primer mensaje que lo trae y no se reemplaza.
model LeadSource {
  leadId       String   @id
  /// AD (anuncio o publicación de Meta) o LINK (enlace /wa con UTM).
  kind         String
  /// Lo que manda Meta en el primer mensaje desde un anuncio.
  adId         String?
  /// "ad" o "post".
  adType       String?
  adHeadline   String?
  adBody       String?
  adUrl        String?
  /// Id del clic en anuncios a WhatsApp: la API de Conversiones lo usa para atribuir la venta.
  ctwaClid     String?
  /// Nombres del anuncio, conjunto y campaña según la API de Marketing (si el token lo permite).
  adName       String?
  adsetName    String?
  campaignId   String?
  campaignName String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  /// Página desde donde la persona hizo clic.
  landingUrl   String?
  createdAt    DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

/// Clic en el enlace /wa desde una landing: guarda los UTM y entrega un código que viaja en el
/// mensaje prellenado de WhatsApp. Cuando llega ese mensaje, los UTM pasan al lead.
model SourceLink {
  code        String   @id
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  landingUrl  String?
  createdAt   DateTime @default(now())
  /// Lead que llegó con este código (el primero).
  leadId      String?

  @@index([createdAt])
}

/// Evento para la API de Conversiones de Meta (ver src/lib/domain/conversions.ts): el lead llegó a
/// la etapa de "lead calificado" o se ganó. Uno por lead y tipo; se reintenta si Meta falla.
model ConversionEvent {
  id        String    @id @default(cuid())
  leadId    String
  /// QUALIFIED (lead calificado) o PURCHASE (venta ganada).
  kind      String
  /// Monto de la venta (CLP), si se conoce.
  value     Int?
  /// PENDING, SENT, FAILED (se reintenta) o SKIPPED (no hay datos para que Meta reconozca al cliente).
  status    String    @default("PENDING")
  error     String?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, kind])
  @@index([status, createdAt])
}

/// Gasto de cada llamada a la IA (lo informa OpenRouter en la respuesta). Alimenta la tabla de
/// consumo de Configuración → Asistente IA.
model AiUsage {
  id           String   @id @default(cuid())
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  /// Dólares.
  cost         Float
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// Webhook saliente (ver src/lib/domain/webhooks.ts): cuando un lead entra a la etapa, Bella envía un
/// POST con los datos del lead a la URL (ej. Zapier, Make, n8n o el sistema del cliente).
model Webhook {
  id        String   @id @default(cuid())
  name      String
  url       String
  stageId   String
  /// Clave con que se firma el cuerpo (HMAC SHA-256 en la cabecera X-Bella-Signature).
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  stage      Stage             @relation(fields: [stageId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([stageId])
}

/// Envío de un webhook: el cuerpo se arma al entrar a la etapa y se reintenta si la URL falla.
model WebhookDelivery {
  id         String    @id @default(cuid())
  webhookId  String
  leadId     String
  payload    Json
  /// PENDING, SENDING, SENT o FAILED (se reintenta hasta 5 veces).
  status     String    @default("PENDING")
  attempts   Int       @default(0)
  /// Código HTTP de la última respuesta, si hubo.
  httpStatus Int?
  error      String?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([webhookId, createdAt])
}

/// Resumen semanal de las conversaciones hecho por la IA (ver src/lib/ai/weekly-insights.ts): qué
/// piden los clientes, dónde se traba el embudo, fortalezas y oportunidades. Se ve en Métricas.
model WeeklyInsight {
  id          String   @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime @unique
  /// Secciones del informe (WeeklyReport en weekly-insights.ts).
  report      Json
  /// Números del período: leads, abiertos, ganados, perdidos y monto.
  stats       Json
  model       String
  /// Admins que ya lo abrieron; a los demás se les marca "nuevo" en el menú.
  seenBy      String[] @default([])
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
