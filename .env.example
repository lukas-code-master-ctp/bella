# Postgres. En Supabase: DATABASE_URL = conexión "Transaction pooler" (puerto 6543)
# terminada en ?pgbouncer=true, y DIRECT_URL = conexión "Session pooler" (puerto 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bella"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bella"

# Usuario admin que se crea en el primer despliegue (si no existe)
SEED_ADMIN_EMAIL="admin@bella.local"
SEED_ADMIN_PASSWORD=""

# Secreto para firmar la sesión (genera uno con: openssl rand -base64 32)
SESSION_SECRET="cambia-esto-por-un-secreto-largo"

# IA: clave de OpenRouter (https://openrouter.ai/keys). El modelo se elige en Configuración.
OPENROUTER_API_KEY=""
# Opcional: para usar la API de Anthropic directo (https://console.anthropic.com)
# ANTHROPIC_API_KEY=""

# Notas de voz: se guardan en Vercel Blob. Vercel agrega BLOB_STORE_ID solo al crear un
# Blob store en Storage y conectarlo al proyecto.
# Para correr en local, copia el token del store:
# BLOB_READ_WRITE_TOKEN=
# Opcional: modelo de OpenRouter que transcribe los audios (usa OPENROUTER_API_KEY).
# TRANSCRIPTION_MODEL=google/gemini-2.5-flash

# Protege /api/cron/inventory, /api/cron/auto-close y /api/cron/follow-ups (Vercel Cron manda "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=""

# Avisos push al navegador (opcional). Genera el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# WhatsApp Cloud API (directa con Meta). Ver Configuración → Canales en la app.
# Token permanente de un usuario del sistema con permiso whatsapp_business_messaging
WHATSAPP_TOKEN=
# Id del número en la app de Meta (WhatsApp → Configuración de la API), no el número en sí
WHATSAPP_PHONE_NUMBER_ID=
# Clave secreta de la app de Meta (firma los webhooks)
META_APP_SECRET=
# Texto que inventas y pegas en Meta al registrar el webhook /api/webhooks/whatsapp
META_VERIFY_TOKEN=

# Instagram Direct y Facebook Messenger (misma app de Meta; webhook /api/webhooks/meta)
# Token permanente de la página de Facebook (pages_messaging, instagram_manage_messages)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
# Opcional: id de la cuenta profesional de Instagram vinculada a la página
META_IG_ACCOUNT_ID=

# Origen de leads (opcional): token con permiso ads_read para ver el nombre de la campaña y del
# conjunto de los anuncios de clic a WhatsApp/Instagram/Messenger. Sin él se prueba con WHATSAPP_TOKEN.
META_ADS_TOKEN=

# Píxel de Meta (API de Conversiones). Se enciende en Configuración → Píxel de Meta.
# Token del Administrador de eventos (tu píxel → Configuración → Generar token de acceso)
META_CAPI_TOKEN=
# Opcional: id de la cuenta de WhatsApp Business, para atribuir ventas a anuncios de clic a WhatsApp
WHATSAPP_BUSINESS_ACCOUNT_ID=
