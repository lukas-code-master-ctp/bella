# Postgres. En Supabase: DATABASE_URL = conexión "Transaction pooler" (puerto 6543)
# terminada en ?pgbouncer=true, y DIRECT_URL = conexión "Session pooler" (puerto 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bella"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bella"

# Usuario admin que se crea en el primer despliegue (si no existe)
SEED_ADMIN_EMAIL="admin@bella.local"
SEED_ADMIN_PASSWORD=""

# Secreto para firmar la sesión (genera uno con: openssl rand -base64 32)
SESSION_SECRET="cambia-esto-por-un-secreto-largo"

# IA: clave de OpenRouter (https://openrouter.ai/keys). El modelo se elige en Configuración.
OPENROUTER_API_KEY=""
# Opcional: para usar la API de Anthropic directo (https://console.anthropic.com)
# ANTHROPIC_API_KEY=""

# Protege /api/cron/inventory (Vercel Cron manda "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=""
